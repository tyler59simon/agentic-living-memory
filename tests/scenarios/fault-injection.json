{
 "name": "fault-injection",
 "description": "Failures inside fail-open housekeeping are logged as internal warnings while the hook still answers; a failure the hook cannot absorb is logged as an error and the adapter fails open.",
 "in_process_only": true,
 "notes": [
  {"key": "parser", "title": "Parser error handling", "body": "Errors in src/parser.py are collected and reported together."}
 ],
 "steps": [
  {"hook": "session-start"},
  {"hook": "user-prompt", "payload": {"prompt": "speed up the tokenizer"}},
  {"fault": "core.search.file_notes", "raise": "RuntimeError", "only": ["claude", "codex"]},
  {"hook": "pre-tool-use", "only": ["claude", "codex"], "payload": {"tool_name": "Edit", "tool_input": {"file_path": "{project}/src/parser.py"}}, "expect": {"mutation": "tracked", "hints": [], "internal": ["runtime.file_hints"]}},
  {"fault": "core.common.display_path", "raise": "ValueError"},
  {"hook": "pre-tool-use", "payload": {"tool_name": "Edit", "tool_input": {"file_path": "{project}/src/lexer.py"}}, "expect": {"mutation": "tracked", "internal": ["runtime.touched_paths"]}},
  {"hook": "stop", "expect": {"reminder": "mutating"}},
  {"fault": "core.sync.sync_all", "raise": "OSError", "only": ["claude"]},
  {"hook": "session-end", "only": ["claude"], "expect": {"internal": ["runtime.sync_vaults"], "level": "info"}},
  {"fault": "core.session_start.build_context", "raise": "RuntimeError"},
  {"hook": "session-start", "expect": {"level": "error", "system_message": true}, "expect_by_harness": {"copilot": {"level": "error", "system_message": false}}}
 ]
}
